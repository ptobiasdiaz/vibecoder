{
  "database": "/var/lib/vibecoder/vibecoder.db",
  "accounts": "/etc/vibecoder/accounts.json",
  "task_workspace_root": "/var/lib/vibecoder/workspaces",
  "authorized_users": [],
  "github_token_env": "VIBECODER_GITHUB_TOKEN",
  "operational_state": "NOT_CONFIGURED",
  "inference_enabled": false,
  "publication_enabled": false,
  "remote_reads_enabled": false,
  "projects": {},
  "intervals": {
    "issues": 120,
    "pull_requests": 120,
    "approvals": 120,
    "tasks": 30,
    "recovery": 180,
    "idle": 10
  },
  "limits": {
    "global_active": 1,
    "per_project": 1,
    "per_agent": 1,
    "per_account": 1,
    "github_active": 1,
    "jobs_per_cycle": 10,
    "lease_seconds": 900,
    "max_attempts": 5,
    "execution_timeout": 900,
    "shutdown_grace": 30,
    "backoff_initial": 10,
    "backoff_max": 900
  },
  "log_level": "INFO"
}
