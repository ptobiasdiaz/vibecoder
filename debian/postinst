#!/bin/sh
set -e

if ! getent group vibecoder >/dev/null; then
    addgroup --system vibecoder
fi
if ! getent group vibecoder-admin >/dev/null; then
    addgroup --system vibecoder-admin
fi
if ! getent group vibecoder-runtime >/dev/null; then
    addgroup --system vibecoder-runtime
fi
if ! getent passwd vibecoder >/dev/null; then
    adduser --system --ingroup vibecoder --home /var/lib/vibecoder \
        --no-create-home --shell /usr/sbin/nologin --disabled-password vibecoder
fi
adduser vibecoder vibecoder-runtime >/dev/null 2>&1 || true
install -d -o vibecoder -g vibecoder -m 0750 /var/lib/vibecoder
install -d -o vibecoder -g vibecoder-runtime -m 0710 /var/lib/vibecoder/workspaces
install -d -o vibecoder -g vibecoder-runtime -m 0710 /var/lib/vibecoder/workers
install -d -o vibecoder -g vibecoder -m 0750 /var/lib/vibecoder/plugins
install -d -o vibecoder -g vibecoder -m 0700 /var/lib/vibecoder/secrets
install -d -o vibecoder -g vibecoder -m 0700 /var/lib/vibecoder/backups
install -d -o vibecoder -g vibecoder-runtime -m 0750 /run/vibecoder

if command -v systemctl >/dev/null && [ -d /run/systemd/system ]; then
    systemctl daemon-reload
    systemctl enable vibecoder-worker-launcher.service vibecoder.service
    systemctl start vibecoder-worker-launcher.service
    systemctl restart vibecoder.service
fi

#DEBHELPER#
