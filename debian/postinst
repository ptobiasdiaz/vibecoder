#!/bin/sh
set -e

if ! getent group vibecoder >/dev/null; then
    addgroup --system vibecoder
fi
if ! getent passwd vibecoder >/dev/null; then
    adduser --system --ingroup vibecoder --home /var/lib/vibecoder \
        --no-create-home --shell /usr/sbin/nologin --disabled-password vibecoder
fi

install -d -o root -g vibecoder -m 0750 /etc/vibecoder
install -d -o vibecoder -g vibecoder -m 0750 /var/lib/vibecoder
install -d -o vibecoder -g vibecoder -m 0750 /var/lib/vibecoder/accounts
install -d -o vibecoder -g vibecoder -m 0750 /var/lib/vibecoder/workspaces
install -d -o vibecoder -g vibecoder -m 0750 /var/lib/vibecoder/state
install -d -o vibecoder -g vibecoder -m 0700 /var/lib/vibecoder/secrets
install -d -o vibecoder -g vibecoder -m 0700 /var/lib/vibecoder/backups
install -d -o vibecoder -g vibecoder -m 0700 /var/lib/vibecoder/recovery

for file in /etc/vibecoder/supervisor.json /etc/vibecoder/accounts.json; do
    if [ -e "$file" ]; then
        chown root:vibecoder "$file"
        chmod 0640 "$file"
    fi
done

# Initialize/migrate through the Python administration service, never ad-hoc SQL.
# debconf contains only a non-secret attribution identifier.
. /usr/share/debconf/confmodule
db_get vibecoder/initial-admin-id || RET=
initial_admin_id=${RET:-}
if [ -n "${2:-}" ]; then
    vibecoder-admin --config /etc/vibecoder/supervisor.json \
        maintenance package-upgrade --previous-version "$2" >/dev/null
fi
if [ -n "$initial_admin_id" ]; then
    if ! vibecoder-admin --config /etc/vibecoder/supervisor.json setup bootstrap-admin \
        --admin-id "$initial_admin_id" --source debconf >/dev/null; then
        echo "vibecoder: initial administrator was not changed; run 'vibecoder-admin setup init'" >&2
    fi
else
    vibecoder-admin --config /etc/vibecoder/supervisor.json setup bootstrap-admin \
        --source debconf >/dev/null
fi

vibecoder-admin --config /etc/vibecoder/supervisor.json \
    maintenance finish-upgrade --previous-version "${2:-}" >/dev/null

if [ -e /var/lib/vibecoder/vibecoder.db ]; then
    chown vibecoder:vibecoder /var/lib/vibecoder/vibecoder.db
    chmod 0640 /var/lib/vibecoder/vibecoder.db
fi

db_get vibecoder/show-first-run-hint || RET=false
operational_state=$(vibecoder-admin --config /etc/vibecoder/supervisor.json \
    --json status | python3 -c 'import json,sys; print(json.load(sys.stdin)["operational_state"])')
if [ "${RET:-false}" = true ] && [ "$operational_state" = NOT_CONFIGURED ]; then
    echo "vibecoder remains NOT_CONFIGURED. Continue with: sudo vibecoder-admin setup init"
fi
db_stop

#DEBHELPER#
