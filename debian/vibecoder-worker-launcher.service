[Unit]
Description=Vibecoder constrained worker launcher
Before=vibecoder.service

[Service]
Type=simple
User=root
Group=root
ExecStart=/usr/bin/vibecoder-worker-launcherd
ExecStartPre=/usr/bin/install -d -o vibecoder -g vibecoder-runtime -m 0711 /run/vibecoder
Restart=on-failure
RestartSec=2s
UMask=0077
NoNewPrivileges=no
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/vibecoder/workers /var/lib/vibecoder/workspaces /var/lib/vibecoder/backups /run/vibecoder /etc
RestrictSUIDSGID=true
LockPersonality=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=false
RestrictAddressFamilies=AF_UNIX

[Install]
WantedBy=multi-user.target
