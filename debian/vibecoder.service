[Unit]
Description=Vibecoder 0.0.1 orchestration daemon
Documentation=file:/usr/share/doc/vibecoder/README.md.gz
After=local-fs.target network-online.target vibecoder-worker-launcher.service
Wants=network-online.target
Requires=vibecoder-worker-launcher.service

[Service]
Type=simple
User=vibecoder
Group=vibecoder
WorkingDirectory=/var/lib/vibecoder
SupplementaryGroups=vibecoder-admin vibecoder-runtime
ExecStart=/usr/bin/vibecoderd --worker-helper /run/vibecoder/worker-launch.sock
Restart=on-failure
RestartSec=10s
TimeoutStopSec=30s
KillSignal=SIGTERM
UMask=0027

StateDirectory=vibecoder
StateDirectoryMode=0750
RuntimeDirectory=vibecoder
RuntimeDirectoryMode=0750
PrivateTmp=true
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/vibecoder /run/vibecoder
CapabilityBoundingSet=
AmbientCapabilities=
RestrictSUIDSGID=true
LockPersonality=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
